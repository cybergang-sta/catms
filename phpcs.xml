<?xml version="1.0"?>
<ruleset name="CATMS">
    <description>
        Coding standard for the Classroom Allocation &amp; Timetable Management System.

        PSR-12 is the floor, not the target. The additional rules exist because
        this codebase has specific failure modes a generic standard will not catch:

          * Global functions are forbidden inside src/Domain (see ForbiddenFunctions).
            DeterminismTest asserts the engine is independent of PHP's global PRNG;
            the linter is what stops a well-meaning contributor reintroducing it.
          * declare(strict_types=1) is mandatory. It is what turns an integer
            overflow into a fatal TypeError instead of a silently wrong answer —
            the exact failure that shipped in the first draft of Rng.php.
          * Slevomat's useless-code rules are on because dead code in a cost
            function is not dead, it is a term silently contributing zero.

        Run: composer lint      Auto-fix: composer fix

        A NOTE ON SNIFF NAMES
        ---------------------
        A ref to a sniff that does not exist is a fatal error, not a warning:
        phpcs aborts before it reads a single file. This ruleset shipped with 31
        refs that resolve in no version of Slevomat, so `composer lint` — and the
        CI job that calls it — has never run. Several were plausible-looking
        names rather than typos of real ones, so they read correctly in review.

        Every ref below was checked against the sniffs actually on disk in
        vendor/. When adding one, confirm it exists first:

            php vendor/bin/phpcs -e | Select-String Category

        Names that changed during this repair are marked "was:" with the reason.
    </description>

    <file>src</file>
    <file>tests</file>
    <file>bin</file>
    <file>config</file>
    <file>public</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/db/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>

    <arg name="colors"/>
    <!-- `console` is the extension-less entry point. It is a PHP file like any
         other and gets the same treatment; without this it would be the one
         script in the repository that no tool ever reads. -->
    <arg name="extensions" value="php,console"/>
    <arg name="basepath" value="."/>
    <arg value="sp"/>

    <!-- PSR-12, with this project's line length. -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
            <!-- Comments are exempt; code is not. This codebase explains itself in
                 long-form doc comments on purpose, and a 120-column gate on prose
                 produces one of two bad outcomes: either the reasoning gets
                 truncated to satisfy a column count, or the author stops writing
                 it. Neither is what the column limit is for. It still binds on
                 every line of actual code, which is the thing a reader has to
                 scan quickly.

                 It also exempts PHPStan array shapes, which cannot be wrapped
                 without becoming less readable than the thing they describe:

                     @return array{id: string, group: string, passed: bool, ...} -->
            <property name="ignoreComments" value="true"/>
        </properties>
    </rule>
    <rule ref="Generic.PHP.RequireStrictTypes"/>
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>

    <!-- Type safety. -->
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <!-- The blank-line form, not <?php declare(...); on one line.
                 Every file in this repository uses

                     <?php

                     declare(strict_types=1);

                 which is what PSR-12 asks for and what an editor's "insert
                 strict types" action produces. `declareOnFirstLine=true` would
                 have demanded the single-line form and failed on all 109
                 correct files; `linesCountBeforeDeclare=1` states the actual
                 convention, so a contributor who omits the blank line is told
                 so rather than being told the whole codebase is wrong. -->
            <property name="declareOnFirstLine" value="false"/>
            <property name="linesCountBeforeDeclare" value="1"/>
            <property name="spacesCountAroundEqualsSign" value="0"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>
    <!-- was: TypeHints.ClassMemberTypeHint, which no longer exists. Slevomat 8
         split it per member kind, so the constant half is named explicitly here
         and the property half is the rule above. Method signatures are already
         covered by ParameterTypeHint and ReturnTypeHint. -->
    <rule ref="SlevomatCodingStandard.TypeHints.ClassConstantTypeHint"/>
    <!-- DisallowMixedTypeHint was removed. It forbade `mixed` outright, which
         is incompatible with the way this codebase documents data: 255 PHPDoc
         array shapes in src/ are written as array<string, mixed> or
         array{id: int, ...} because that is what PHPStan checks against. The
         rule would have forced every one of them to be deleted, which removes
         the type information rather than improving it. The useful half of the
         idea — do not put `mixed` in a *signature* — is still covered, because
         a native `mixed` return or parameter is what PHPStan level 6 flags. -->
    <rule ref="SlevomatCodingStandard.TypeHints.DNFTypeHintFormat"/>

    <!-- Dead and duplicated code. -->
    <rule ref="SlevomatCodingStandard.PHP.DisallowDirectMagicInvokeCall"/>
    <!-- was: PHP.UselessElse, PHP.UselessReturn, PHP.UselessParentCall — none of
         which exist. The intent was "no code that does nothing", and these are
         the sniffs that actually express it. -->
    <rule ref="Squiz.PHP.NonExecutableCode"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessIfConditionWithReturn"/>
    <!-- was: PHP.DisallowShortTernary. Slevomat moved it under ControlStructures
         and renamed it to the ...Operator form. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.DisallowShortTernaryOperator"/>
    <rule ref="SlevomatCodingStandard.PHP.RequireExplicitAssertion"/>
    <!-- ignoreConstructors was removed from the properties below. The property
         does not exist on this sniff, and removing it changes nothing: the sniff
         already returns early for __construct (DisallowEmptyFunctionSniff.php
         checks the name before reporting). This codebase uses constructor
         property promotion in Command, Controller and MysqlUserRepository, and
         a promoted-property constructor has nothing to put in its body. -->
    <rule ref="SlevomatCodingStandard.Functions.DisallowEmptyFunction">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.UnusedParameter"/>

    <!-- No hidden global state. The two rules below are the same idea at two
         different scopes, because "deterministic" and "reads the wall clock"
         are not the same requirement:

           1. The global PRNG is forbidden everywhere in the application. A
              random number that did not come from App\Domain\Allocation\Rng
              makes the engine irreproducible, and a random number in a request
              path makes a bug uninvestigable.
           2. Wall-clock reads are forbidden in the *engine* only. Outside
              src/Domain/Allocation the clock is not a correctness hazard but a
              fact — a log line needs a timestamp and a JWT needs `iat` — so
              forbidding time() repo-wide would only teach people to reach for
              the forbidden name in a disguise. Inside the engine it is a
              determinism bug waiting to happen: SystemClock and the injected
              Clock port are the only legitimate readers. -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="rand" value="null"/>
                <element key="mt_rand" value="null"/>
                <element key="srand" value="null"/>
                <element key="mt_srand" value="null"/>
                <element key="shuffle" value="null"/>
                <element key="array_rand" value="null"/>
                <element key="uniqid" value="null"/>
            </property>
        </properties>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- was: SlevomatCodingStandard.PHP.ForbiddenFunctions, which does not
         exist. ForbiddenFunctions is a PHPCS core sniff, under Generic.PHP, and
         it uses the same `forbiddenFunctions` property name — so the two
         determinism guards below work exactly as written, only the standard
         prefix changed. DeterminismTest asserts the engine is independent of
         PHP's global PRNG; this is the rule that stops it being reintroduced. -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="time" value="null"/>
                <element key="date" value="null"/>
                <element key="gmdate" value="null"/>
                <element key="microtime" value="null"/>
                <element key="hrtime" value="null"/>
            </property>
        </properties>
        <include-pattern>src/Domain/Allocation/*</include-pattern>
        <exclude-pattern>src/Domain/Allocation/SystemClock.php</exclude-pattern>
    </rule>

    <!-- Imports and namespaces. UnusedUses and ReferenceUsedNamesOnly together
         catch a stale import and a reference that spells out a fully qualified
         name the file has already imported. -->
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UseSpacing"/>
    <!-- was: Namespaces.UseClassKeyword, Namespaces.FullyQualifiedGlobalClasses,
         Namespaces.FullyQualifiedExceptionClasses, Namespaces.UsedAttributesOnlyInAttributes.
         The first and fourth do not exist; the other two were renamed. The two
         rules below are what actually catch an FQ name that should have been an
         import, and an exception class spelled out in full. -->
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly"/>
    <rule ref="SlevomatCodingStandard.Namespaces.FullyQualifiedExceptions"/>
    <rule ref="SlevomatCodingStandard.Attributes.RequireAttributeAfterDocComment"/>
    <!-- was: Namespaces.ClassStructure. It lives under Classes. -->
    <rule ref="SlevomatCodingStandard.Classes.ClassStructure"/>

    <!-- Control structures. EarlyExit keeps the cost function readable: the
         early-return shape is what keeps a 7-term expression legible. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireSingleLineCondition"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireMultiLineCondition"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireMultiLineTernaryOperator"/>
    <!-- was: ControlStructures.DisallowYodaConditions -> DisallowYodaComparison.
         The three rules after it (RequireExplicitBooleanOperatorPrecedence,
         ForbiddenSwitchDefault, RequireExitExpression) have no equivalent in this
         Slevomat version and were dropped rather than replaced with a rule that
         checks something else. RequireTernaryOperator would have been the
         closest, but it is a style preference this codebase does not hold. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.DisallowYodaComparison"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
    <!-- was: ControlStructures.DisallowEmptyLoop, which covers only loops. This
         is the general form and also catches an empty branch. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.DisallowEmpty"/>

    <!-- Arrays and functions. -->
    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>
    <!-- was: Arrays.MultiLineArrayEndingBracketPlacement (the real name drops
         the "ing"), Arrays.SingleLineArrayWhitespaceBeforeClosingBrace and
         Arrays.RequireSingleLineArrayFormatting (both folded into
         SingleLineArrayWhitespace). Arrays.SingleLineArrayIndentation has no
         Slevomat equivalent; PSR-12's own Squiz.Arrays.ArrayDeclaration
         already covers it, since PSR12 is referenced above. -->
    <rule ref="SlevomatCodingStandard.Arrays.MultiLineArrayEndBracketPlacement"/>
    <rule ref="SlevomatCodingStandard.Arrays.SingleLineArrayWhitespace"/>
    <!-- Functions.DisallowTrailingCommaInDeclaration was removed because it
         directly contradicts the standard this ruleset is built on. PSR-12
         §2.3 requires a trailing comma when a parameter list is split across
         lines; this Slevomat rule forbids one. Both cannot hold, and PSR-12
         wins because it is referenced in full above and is what phpcbf and
         editors assume. This is why the multi-line declarations in this
         codebase end with a comma. -->
    <!-- was: Functions.NullableTypeDeclaration and Functions.ReturnTypeHintSpacing.
         Both moved under the TypeHints category. -->
    <rule ref="SlevomatCodingStandard.TypeHints.NullableTypeForNullDefaultValue"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHintSpacing"/>
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>

    <!-- Operators, casts, whitespace. -->
    <rule ref="SlevomatCodingStandard.Operators.DisallowEqualOperators"/>
    <rule ref="SlevomatCodingStandard.Operators.RequireCombinedAssignmentOperator"/>
    <rule ref="SlevomatCodingStandard.Operators.SpreadOperatorSpacing"/>
    <!-- was: Operators.DisallowMultipleAssignments (a PHPCS core sniff, under
         Squiz.PHP) and Operators.RequireNullSafeOperator (moved to
         ControlStructures and renamed ...ObjectOperator).
         Operators.RequireShortFormIncrementDecrementOperators has no equivalent
         and was dropped. -->
    <rule ref="Squiz.PHP.DisallowMultipleAssignments"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullSafeObjectOperator"/>
    <!-- was: CastLengthCastSniff and CastSpacing, neither of which is a Slevomat
         sniff — the first is not a real name at all. Cast spacing is a PHPCS
         core rule. -->
    <rule ref="Squiz.WhiteSpace.CastSpacing"/>
    <!-- was: Whitespace.LanguageConstructSpacing, which is a PHPCS core sniff
         under Squiz.WhiteSpace — and deprecated since PHPCS 3.3.0 in favour of
         the Generic.WhiteSpace rule of the same name. Using the deprecated one
         would emit a removal warning on every run.
         Whitespace.ParenthesesSpacing does not exist in this version; PSR-12's
         own Squiz.WhiteSpace.SuperfluousWhitespace already rejects the
         space-inside-parentheses case. -->
    <rule ref="Generic.WhiteSpace.LanguageConstructSpacing"/>

    <!-- Documentation. docs/ALLOCATION_ENGINE.md is only trustworthy if the code
         that implements it is documented where the constraint is enforced. -->
    <rule ref="SlevomatCodingStandard.Commenting.DocCommentSpacing"/>
    <rule ref="SlevomatCodingStandard.Commenting.EmptyComment"/>
    <rule ref="SlevomatCodingStandard.Commenting.UselessFunctionDocComment"/>
    <rule ref="SlevomatCodingStandard.Commenting.UselessInheritDocComment"/>
    <!-- was: Commenting.DocCommentAlignment, a PHPCS core sniff under
         Squiz.Commenting. Commenting.DocCommentIndentation does not exist;
         Squiz.Commenting.DocCommentAlignment checks the indentation of the
         aligned annotation block as well. -->
    <rule ref="Squiz.Commenting.DocCommentAlignment"/>
    <rule ref="SlevomatCodingStandard.Commenting.AnnotationName"/>
    <rule ref="SlevomatCodingStandard.Commenting.RequireOneLinePropertyDocComment"/>
</ruleset>
