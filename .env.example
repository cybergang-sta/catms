# ─────────────────────────────────────────────────────────────────────────────
#  CATMS — local development environment
#
#  Copy to `.env` and edit:  cp .env.example .env
#
#  .env is gitignored and is NOT copied into the container image. In staging
#  and production every variable here is injected by the orchestrator, and the
#  real environment always wins over this file (see src/Core/Config.php).
#
#  Rule of thumb: a value with a real secret in it is supplied by the secret
#  store and never committed. An empty value below means "fill me in".
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
# local | staging | production
APP_ENV=local

# Never true in production — Config::assertProductionSafe() refuses to boot.
APP_DEBUG=true

APP_URL=http://localhost:8080

# Display only. Every timestamp is stored in UTC and converted on the way out.
APP_TIMEZONE=Africa/Accra

# Signs access tokens (HS256). MUST be at least 32 characters in production.
# Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Rotating this invalidates every issued access token; see docs/DEPLOYMENT.md §9.
APP_KEY=

# All routes are mounted under this prefix. Matches docs/API.md.
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────────────────────
# With `docker compose up`, the host is the compose service name.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=utas_catms
DB_USERNAME=catms_app
DB_PASSWORD=catms_app

# Optional read replica. Reports prefer it when set, and degrade to the primary
# when it is unreachable rather than failing the request.
DB_REPLICA_HOST=

# ── Security ────────────────────────────────────────────────────────────────
# bcrypt work factor. 12 is the current floor; raising it does NOT invalidate
# existing hashes, because Authenticator re-hashes on next successful login.
PASSWORD_BCRYPT_COST=12

# Access token lifetime, seconds. Kept short because refresh tokens are opaque,
# revocable and stored hashed; an access token cannot be revoked.
ACCESS_TOKEN_TTL=900

# Refresh token lifetime, seconds. 30 days.
REFRESH_TOKEN_TTL=2592000

# Lockout after repeated failures, so the login bucket cannot be used to
# enumerate accounts one guess at a time.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Comma-separated. Empty disables CORS entirely, which is correct when the PWA
# is served from the same origin as the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Allocation engine ───────────────────────────────────────────────────────
# Recorded on every allocation_runs row, so a published timetable can always be
# traced back to the code and settings that produced it.
ENGINE_VERSION=1.0.0

# The greedy construction is fully deterministic for a given seed. The local
# search is additionally time-boxed, so two machines may take different numbers
# of iterations; pin the iteration count when you need an identical result.
ENGINE_SEED=20260801
ENGINE_MAX_ITERATIONS=2000

# Hard ceiling on one solve. Must stay well under the 30 s PHP limit of
# NFR-PERF-02; 2.5 s is what leaves room for loading and persisting.
ENGINE_TIME_BUDGET_SECONDS=2.5

# A run below this accuracy is reported as infeasible and is never auto-committed.
ENGINE_ACCURACY_GATE=0.90

# Maximum sittings one lecturer may be given in a day. A soft limit, expressed
# in the cost function's equity term rather than as a hard constraint: a lecturer
# who is genuinely the only person qualified to teach something still gets the
# extra sitting, and the timetable says so, rather than the sitting silently
# disappearing. Read by `generate` and by `smoke`.
ENGINE_MAX_LECTURER_SESSIONS_PER_DAY=4

# ── Notifications ───────────────────────────────────────────────────────────
NOTIFY_IN_APP=true
NOTIFY_EMAIL=true

# Local development sends to mailpit (docker compose service `mailpit`), which
# catches everything in a web UI at http://localhost:8025. Nothing leaves the
# machine. `log` writes the message to the application log instead.
MAIL_TRANSPORT=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=timetables@utas.edu.gh
MAIL_FROM_NAME=UTAS Timetable

# Outbox drain settings for bin/worker.php. The outbox exists so that a slow or
# unreachable SMTP server cannot push a request past its 3 s response budget
# (ADR-003).
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=200

# ── Storage ─────────────────────────────────────────────────────────────────
# Leave empty to use <project>/storage. Set it for a packaged install where the
# application directory is read-only and only this path is writable.
STORAGE_PATH=

# ── Observability ───────────────────────────────────────────────────────────
# debug | info | warning | error. Must not be `debug` in production.
LOG_LEVEL=debug

METRICS_ENABLED=true

# Optional. Empty disables error reporting entirely.
SENTRY_DSN=

# ── Maintenance mode ────────────────────────────────────────────────────────
# Not an environment variable: maintenance mode is the presence of the file
# storage/maintenance.flag, so it can be turned on when the database is down.
#   php bin/console app:maintenance --enable
#   php bin/console app:maintenance --disable
# Reads (GET/HEAD) are still served while the flag exists.
